      "seed": 2081582499,
      "version": 334,
      "versionNonce": 766008515,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788091033214,
      "link": null,
      "locked": false,
      "text": "Flow : \n    Question/Prompts \n    Retrieves:\n        AI Search in Knowledge base Pdf, doc, db\n        Text vectors db\n        Retrieve the data \n    Augmentation \n       Adds data to our prompt \n    Generation : \n        Generates our result ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Flow : \n    Question/Prompts \n    Retrieves:\n        AI Search in Knowledge base Pdf, doc, db\n        Text vectors db\n        Retrieve the data \n    Augmentation \n       Adds data to our prompt \n    Generation : \n        Generates our result ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "SsTjbrLNNnB2cnKOFG1gq",
      "type": "text",
      "x": 526,
      "y": 1913.5,
      "width": 522.2596435546875,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
