      "isDeleted": false,
      "boundElements": [],
      "updated": 1788095857289,
      "link": null,
      "locked": false,
      "text": "therefore : \nuser question -> embedding model -> split into vectors -> \nvector db -> RAG -> transformer -> Read question + retrieval data\n-> output ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "therefore : \nuser question -> embedding model -> split into vectors -> \nvector db -> RAG -> transformer -> Read question + retrieval data\n-> output ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
