      "isDeleted": false,
      "boundElements": [],
      "updated": 1788088852506,
      "link": null,
      "locked": false,
      "text": "in vectordb - data will store like : \n    {\n        id : \"chunk001\", \n         values : \"23.12, -2.34, ...\"\n        metadata :  {\n                source : \"java web server pdf\",\n                page: \"23\"\n            }\n    }",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "in vectordb - data will store like : \n    {\n        id : \"chunk001\", \n         values : \"23.12, -2.34, ...\"\n        metadata :  {\n                source : \"java web server pdf\",\n                page: \"23\"\n            }\n    }",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jG7UM6vvvrrtC9HiRzoe8",
      "type": "text",
      "x": 524,
      "y": 1490.5,
      "width": 445.3796691894531,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
