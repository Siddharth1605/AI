      "updated": 1788090907177,
      "link": null,
      "locked": false,
      "text": "tech stacks : \n    vectordb(pinecone), \n    framework : langchain(to build rag, agents)\n    embedding model : openai text embedding\n    llm model : openai",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "tech stacks : \n    vectordb(pinecone), \n    framework : langchain(to build rag, agents)\n    embedding model : openai text embedding\n    llm model : openai",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "_1dy8t4wODAx8VZwrSYs8",
      "type": "text",
      "x": 512,
      "y": 1645.5,
      "width": 468.67974853515625,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
